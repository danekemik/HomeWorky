# Токен бота от @BotFather
BOT_TOKEN=

# Строка подключения к PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/homework_bot

# Redis для FSM-состояний (если пусто — используется MemoryStorage)
REDIS_URL=redis://localhost:6379/0

# Часовой пояс бота (для дат и времени уведомлений)
TIMEZONE=Europe/Moscow

# Время вечернего напоминания про дедлайны на завтра (HH:MM)
REMINDER_TIME=20:00

# Зарезервировано: утреннее напоминание (пока не используется)
DEADLINE_MORNING_TIME=09:00

# Уровень логирования
LOG_LEVEL=INFO

# Пароль Postgres (используется docker-compose)
POSTGRES_PASSWORD=postgres